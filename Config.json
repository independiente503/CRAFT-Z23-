{
  "system": {
    "name": "CRAFT-Z23",
    "mode": "production",
    "language": "es"
  },

  "security": {
    "rate_limit": {
      "max_messages": 5,
      "window_seconds": 10
    },
    "prompt_guard": {
      "enabled": true
    },
    "watchdog": {
      "enabled": true,
      "interval_seconds": 5
    }
  },

  "memory": {
    "file": "craft_z23_memory.json",
    "max_per_user": 50
  },

  "llm": {
    "provider": "external_or_local",
    "timeout_seconds": 10,
    "max_prompt_chars": 4000
  },

  "logging": {
    "audit_enabled": true,
    "audit_file": "audit_log.json"
  }
}